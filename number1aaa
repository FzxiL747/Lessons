def knapsack(W, wt, val):
 n = len(wt)
 dp = [[0] * (W + 1) for _ in range(n + 1)]
 for i in range(1, n + 1):
 for w in range(W + 1):
 dp[i][w] = dp[i-1][w] # skip item
 if wt[i-1] <= w: # take item
 dp[i][w] = max(dp[i][w], val[i-1] + dp[i-1][w - wt[i-1]])
 w, items = W, []
 for i in range(n, 0, -1): # backtrack
 if dp[i][w] != dp[i-1][w]:
 items.append(i)
 w -= wt[i-1]
 return dp, items[::-1]
dp, items = knapsack(7, [1, 3, 4, 5], [1, 4, 5, 7])
print("DP table:")
for row in dp: print(row)
print("Max value:", dp[-1][-1], "| Selected items:", items)




from functools import lru_cache
def count(N, S):
 d = list(map(int, str(N)))
 @lru_cache(None)
 def go(i, s, tight):
 if s > S:
 return 0
 if i == len(d):
 return int(s == S)
 hi = d[i] if tight else 9
 return sum(go(i + 1, s + x, tight and x == hi)
 for x in range(hi + 1))
 return go(0, 0, True)
print("Numbers in [0, 100] with digit sum 5 :", count(100, 5))
print("Numbers in [0, 999] with digit sum 5 :", count(999, 5))


