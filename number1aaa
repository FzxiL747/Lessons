parent = [-1, 0, 0, 1, 1]
depth = [0, 1, 1, 2, 2]

n = 5
LOG = n.bit_length()

up = [[0] * n for _ in range(LOG)]

up[0] = [0 if p == -1 else p for p in parent]

for j in range(1, LOG):
    for v in range(n):
        up[j][v] = up[j-1][up[j-1][v]]


def lca(u, v):
    if depth[u] < depth[v]:
        u, v = v, u

    for j in range(LOG):
        if (depth[u] - depth[v]) & (1 << j):
            u = up[j][u]

    if u == v:
        return u

    for j in range(LOG-1, -1, -1):
        if up[j][u] != up[j][v]:
            u, v = up[j][u], up[j][v]

    return up[0][u]


print(lca(3, 4))
