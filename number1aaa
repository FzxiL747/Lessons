def knapsack(W, wt, val):
 n = len(wt)
 dp = [[0] * (W + 1) for _ in range(n + 1)]
 for i in range(1, n + 1):
 for w in range(W + 1):
 dp[i][w] = dp[i-1][w] # skip item
 if wt[i-1] <= w: # take item
 dp[i][w] = max(dp[i][w], val[i-1] + dp[i-1][w - wt[i-1]])
 w, items = W, []
 for i in range(n, 0, -1): # backtrack
 if dp[i][w] != dp[i-1][w]:
 items.append(i)
 w -= wt[i-1]
 return dp, items[::-1]
