def floyd(n, d):
    for k in range(n):
        for i in range(n):
            for j in range(n):
                d[i][j] = min(d[i][j], d[i][k] + d[k][j])
    return d

INF = float('inf')

d = [[0, 5, INF, 10],
     [INF, 0, 3, INF],
     [INF, INF, 0, 1],
     [INF, -2, INF, 0]]

for row in floyd(4, d):
    print(row)








def bellman(n, edges, src):
    d = [float('inf')] * n
    d[src] = 0

    for _ in range(n-1):
        for u, v, w in edges:
            if d[u] != float('inf'):
                d[v] = min(d[v], d[u] + w)

    for u, v, w in edges:
        if d[u] != float('inf') and d[u] + w < d[v]:
            return "Negative cycle"

    return d


edges = [(0, 1, 4), (0, 2, 5), (1, 2, -2)]

print(bellman(3, edges, 0))










parent = [-1, 0, 0, 1, 1, 2, 3, 5, 5, 6]

n = len(parent)
LOG = n.bit_length()

up = [[-1] * n for _ in range(LOG)]
up[0] = parent[:]

for j in range(1, LOG):
    for v in range(n):
        p = up[j-1][v]
        if p != -1:
            up[j][v] = up[j-1][p]


def kth(v, k):
    for j in range(LOG):
        if k & (1 << j):
            v = up[j][v]
            if v == -1:
                return -1

    return v


