Task 11A: KMP String Matching
def lps(p):
    L=[0]*len(p); k=0
    for i in range(1,len(p)):
        while k and p[i]!=p[k]: k=L[k-1]
        if p[i]==p[k]: k+=1
        L[i]=k
    return L
def kmp(t,p):
    L=lps(p); k=0; res=[]
    for i,c in enumerate(t):
        while k and c!=p[k]: k=L[k-1]
        if c==p[k]: k+=1
        if k==len(p): res.append(i-k+1); k=L[k-1]
    return res
