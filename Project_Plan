Task 11B: Trie (insert, search, prefix count, autocomplete)
class Trie:
    def __init__(s): s.r=[{},0,False]
    def insert(s,w):
        n=s.r
        for c in w: n=n[0].setdefault(c,[{},0,False]); n[1]+=1
        n[2]=True
    def find(s,p):
        n=s.r
        for c in p:
            n=n[0].get(c)
            if not n: return None
        return n
    def search(s,w): n=s.find(w); return bool(n and n[2])
    def count(s,p): n=s.find(p); return n[1] if n else 0
    def auto(s,p):
        out=[]
        def dfs(n,w):
            if n[2]: out.append(w)
            for c in sorted(n[0]): dfs(n[0][c],w+c)
        n=s.find(p)
        if n: dfs(n,p)
        return out
t=Trie()
for w in ["apple","app","apply","bat"]: t.insert(w)
