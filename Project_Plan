Task 10: Digit DP (digit sum divisible by K)
from functools import lru_cache
def count(N,K):
    if N<0: return 0
    D=list(map(int,str(N)))
    @lru_cache(None)
    def dp(p,r,t):
        if p==len(D): return int(r==0)
        m=D[p] if t else 9
        return sum(dp(p+1,(r+d)%K,t and d==m) for d in range(m+1))
    return dp(0,0,True)
rng=lambda L,R,K: count(R,K)-count(L-1,K)
brute=lambda L,R,K: sum(sum(map(int,str(x)))%K==0 for x in range(L,R+1))
for L,R,K in [(1,100,3),(10,99,5),(123,4567,9)]: print(L,R,K,rng(L,R,K),brute(L,R,K))
