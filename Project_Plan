Task 9: 0/1 Knapsack (DP)
def knap(wt,val,W):
    n=len(wt); dp=[[0]*(W+1) for _ in range(n+1)]
    for i in range(1,n+1):
        for w in range(W+1):
            dp[i][w]=dp[i-1][w]
            if wt[i-1]<=w: dp[i][w]=max(dp[i][w],dp[i-1][w-wt[i-1]]+val[i-1])
    w,it=W,[]
    for i in range(n,0,-1):
        if dp[i][w]!=dp[i-1][w]: it.append(i-1); w-=wt[i-1]
    return dp,it[::-1]
